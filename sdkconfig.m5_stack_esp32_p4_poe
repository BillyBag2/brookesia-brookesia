# M5Stack Unit PoE-P4 (U213): 16 MB flash and 32 MB in-package PSRAM.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# Brookesia application and resource partitions for the 16 MB flash.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_16m.csv"

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MEMTEST=y

# No onboard wireless coprocessor.
# CONFIG_ESP_WIFI_REMOTE_ENABLED is not set
# CONFIG_ESP_HOSTED_ENABLED is not set
